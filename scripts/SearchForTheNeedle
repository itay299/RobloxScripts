    Settings.autoUpgrade = v
    if v then
        lastCash = nil
        upgradeFired = {}
        trackLevel = {}
        trackBackoff = {}
    end
end, "autoUpgrade")

-- Instant Take tab
local takeTab = UI:Category("Instant Take")
-- NOTE: this fires PickHay directly (no mouse simulation). It auto-pauses
-- while the Automation tab's "Auto Take Hay" is ON, so the two pickers
-- never fight over the server's pick cooldown.
takeTab:Toggle("Instant Take (remote picks)", false, function(v)
    Settings.instantTake = v
end, "instantTake")
-- The server distance-checks picks, so Range Bypass is the opt-in switch for
-- the teleport round-trip that gets past it. Starts OFF every paste, is NOT
-- saved to config, and only picks while it's ON (user: no TP unless asked).
takeTab:Toggle("Range Bypass (TP assist, OFF on rejoin)", false, function(v)
    Settings.rangeBypass = v
end, nil)

-- The server's own pick cooldown is the real limit; expose it as an interval
-- so you can slow it down if you want to look less robotic (never faster).
local intervalBox = takeTab:Textbox("Pick interval (sec)", "0.45", "takeInterval")
local function syncInterval()
    local v = tonumber(intervalBox.Text)
    if v then Settings.takeInterval = math.max(0.3, v) end
end
intervalBox:GetPropertyChangedSignal("Text"):Connect(function()
    if not intervalBox:IsFocused() then syncInterval() end
end)
intervalBox.FocusLost:Connect(syncInterval)
syncInterval()

-- Automation tab: input-driven picking + gems
local autoTab = UI:Category("Automation")
autoTab:Toggle("Auto Take Hay (click/hold what you look at)", false, function(v)
    Settings.autoClick = v
    if not v then aimLockUntil = 0 end
end, "autoClick")
autoTab:Dropdown("Auto Take Hay mode", { "Auto", "Always hold", "Always click" }, "Auto", function(v)
    Settings.autoClickMode = v
end, "autoClickMode")
autoTab:Toggle("Weapon phases (BETA - publish tool use)", false, function(v)
    Settings.weaponPhases = v
end, "weaponPhases")
autoTab:Toggle("Auto Take Gems", false, function(v)
    Settings.autoGems = v
end, "autoGems")
local gemRangeBox = autoTab:Textbox("Gem range (studs)", "15", "gemRange")
local function syncGemRange()
    local v = tonumber(gemRangeBox.Text)
    -- The server's own gem collect distance is 30 (GemConfig), so anything
    -- past that is a silent no-op - cap the setting there.
    if v then Settings.gemRange = math.clamp(v, 1, 30) end
end
gemRangeBox:GetPropertyChangedSignal("Text"):Connect(function()
    if not gemRangeBox:IsFocused() then syncGemRange() end
end)
gemRangeBox.FocusLost:Connect(syncGemRange)
syncGemRange()
autoTab:Button("Debug: Dump Nearby Gems", function()
    gemDebugDump()
end)
autoTab:Button("Debug: What's Under Crosshair", function()
    local t = findHayTarget()
    if not t then print("[SFN] nothing hay-like under the crosshair") return end
    local p = piecePosition(t)
    local root = getRoot()
    local d = (p and root) and (p - root.Position).Magnitude or -1
    print(("[SFN] crosshair -> %s (%s), dist=%.1f, HayId=%s, mutation=%s"):format(
        t:GetFullName(), t.ClassName, d,
        tostring(t:GetAttribute("HayId")),
        tostring(t:GetAttribute("HayMutation"))))
end)

-- ===================================================================
-- AFK AUTO FIND  (whole tab - hands-off needle farming)
-- ===================================================================
-- One toggle does everything: it re-aims Instant Take at hay around you
-- until the needle reveals, keep-digs until the needle is claimed, then
-- (with the walk toggle on) WALKS to the sell pad to cash out so the next
-- round starts fresh. No TP and no simulated input - the remote path is
-- used on purpose (nothing here needs aim), and picks are paced by the
-- server's own cooldown inside the shared pick loop below.

local autoFindBobTime = 0 -- next micro-move (anti-AFK) time
local function autoFindBob(now)
    if now < autoFindBobTime then return end
    autoFindBobTime = now + 45
    local root = getRoot()
    if root then
        pcall(function()
            root.CFrame = root.CFrame * CFrame.new(0, 0.5, 0)
        end)
    end
end

local function afkFindStep()
    if needleClaimed() then return end
    autoFindBob(os.clock())
    pcall(instantTakeStep) -- same pacing Instant Take uses (server cooldown)
end

local afkTab = UI:Category("AFK Auto Find")
afkTab:Toggle("AFK Find Needle (walks to sell, next round)", false, function(v)
    Settings.autoFind = v
    -- taking over the dig loop: pause plain Instant Take so one picker owns
    -- the cooldown (the AFK step runs it itself whenever IT is on)
    if v then Settings.instantTake = false end
end, "autoFind")
afkTab:Toggle("AFK: Walk to Sell Pad", false, function(v)
    Settings.autoFindWalk = v
end, "autoFindWalk")
afkTab:Button("AFK: Status", function()
    local root = getRoot()
    print(("[SFN AFK] enabled=%s walk=%s claimed=%s held=%g/%g pos=%s"):format(
        tostring(Settings.autoFind), tostring(Settings.autoFindWalk),
        tostring(needleClaimed()), hayHeld(), hayCapacity(),
        root and tostring(root.Position) or "?"))
end)

-- Auto Sell tab
local sellTab = UI:Category("Auto Sell")
sellTab:Toggle("Auto Sell (fires with 1+ hay)", false, function(v)
    Settings.autoSell = v
end, "autoSell")
sellTab:Button("Show Capacity / Held", function()
    print(("[SFN] Held: %g / %g"):format(hayHeld(), hayCapacity()))
end)

-- ===================================================================
-- LOOPS
-- ===================================================================
task.spawn(function()
    while UI._frame and UI._frame.Parent do
        -- Needle/key ESP: re-scan every second (findObjectiveInstance has no
        -- reveal gate anymore, so the black highlight appears as soon as the
        -- needle/key exists anywhere in the workspace). Once YOU own the
        -- needle the highlight is pointless, so drop it.
        if Settings.needleESP then
            if LocalPlayer:GetAttribute("NeedleOwned") == true then
                pcall(clearNeedleESP)
            else
                pcall(updateNeedleESP)
            end
        end
        -- Gem ESP catch-up: gems spawn/despawn fast (reveal every 0.7s),
        -- so the same 1s pass re-syncs highlights for any that the watchers
        -- missed (e.g. GemsClient folder appearing after the toggle went on).
        if Settings.gemESP then
            pcall(function()
                local folder = gemsFolder()
                if folder then
                    for _, gem in ipairs(folder:GetChildren()) do
                        if not gemHighlights[gem] then addGemESP(gem) end
                    end
                end
            end)
        end
        -- Mutation ESP auto-refresh (every 1s, no button): picks up new
        -- mutation pieces AND rebuilds highlights whose HayMutation attribute
        -- changed (e.g. indexed mutation -> brand new unknown one, or a
        -- mutation reverting to Normal), so colors never go stale.
        if Settings.mutationESP then
            pcall(function()
                local haystack = workspace:FindFirstChild("HaystackClient")
                if haystack then
                    for _, piece in ipairs(haystack:GetChildren()) do
                        local hl = pieceHighlights[piece]
                        if hl and hl.Parent then
                            if hl:GetAttribute("MutName") ~= piece:GetAttribute("HayMutation") then
                                removePieceESP(piece)
                                addPieceESP(piece)
                            end
                        else
                            addPieceESP(piece)
                        end
                    end
                end
            end)
        end
        task.wait(1)
    end
end)

task.spawn(function()
    while UI._frame and UI._frame.Parent do
        if Settings.instantTake and not Settings.autoClick then
            -- paused while Auto Take Hay drives the (shared) pick cooldown
            pcall(instantTakeStep)
        elseif Settings.autoFind then
            -- AFK Auto Find owns the dig when plain Instant Take is off
            pcall(afkFindStep)
        end
        -- never fire faster than the server's own pick cooldown allows
        task.wait(math.max(Settings.takeInterval, pickCooldown()))
    end
end)

task.spawn(function()
    -- Auto Take Hay: click/hold whatever is under the crosshair. Each pass
    -- holds one full cooldown (step waits inside), so this loop just spins.
    while UI._frame and UI._frame.Parent do
        if Settings.autoClick then
            pcall(autoClickHayStep)
        else
            task.wait(0.2)
        end
    end
end)

task.spawn(function()
    while UI._frame and UI._frame.Parent do
        if Settings.autoSell then
            pcall(autoSellStep)
        end
        task.wait(0.5)
    end
end)

task.spawn(function()
    -- AFK Auto Find round-rollover: once the needle is claimed and hay is
    -- held, WALK (Humanoid:MoveTo, no TP) to the sell pad and cash out so
    -- the next round starts fresh. Digging continues the whole time via
    -- afkFindStep in the pick loop above.
    while UI._frame and UI._frame.Parent do
        if Settings.autoFind and Settings.autoFindWalk and not teleportBusy then
            pcall(function()
                if hayHeld() < 1 then return end
                local root = getRoot()
                local sellPos = sellPosition()
                if not root or not sellPos then return end
                local hum = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
                if not hum then return end
                local dist = (sellPos - root.Position).Magnitude
                if dist <= 14 then
                    hum:MoveTo(root.Position) -- stop at the pad
                    pcall(function() SellHay:FireServer() end)
                    task.wait(0.35)
                    if hayHeld() > 0 then
                        pcall(function() SellHay:FireServer() end)
                        task.wait(0.35)
                    end
                else
                    hum:MoveTo(sellPos) -- walk toward the pad (no teleport)
                end
            end)
        end
        task.wait(0.5)
    end
end)

task.spawn(function()
    -- Auto Upgrade: one attempt per pass; the step itself paces fires 0.75s
    -- apart while it watches for a cash drop confirming the purchase.
    while UI._frame and UI._frame.Parent do
        if Settings.autoUpgrade then
            pcall(autoUpgradeStep)
        end
        task.wait(1)
    end
end)

task.spawn(function()
    -- Auto Gems: quick ticks - prompt/click/remote attempts against the
    -- closest few gems per tick (see AUTO GEMS header for the strategy).
    while UI._frame and UI._frame.Parent do
        if Settings.autoGems then
            pcall(autoGemsStep)
        end
        task.wait(0.3)
    end
end)

-- Full cleanup when the GUI is closed so no highlights linger on the pile.
UI._frame.Destroying:Connect(function()
    Settings.instantTake = false
    Settings.autoClick = false
    Settings.mutationESP = false
    Settings.needleESP = false
    Settings.autoSell = false
    Settings.autoUpgrade = false
    Settings.autoGems = false
    Settings.gemESP = false
    Settings.autoFind = false
    Settings.autoFindWalk = false
    Settings.weaponPhases = false
    Settings.rangeBypass = false -- never leave TP assist armed
    releaseHold() -- never leave a virtual mouse button stuck down
    setHayWatchers(false)
    setGemWatchers(false)
    clearMutationESP()
    clearGemESP()
    clearNeedleESP()
    pcall(function() espHolder:Destroy() end)
end)
